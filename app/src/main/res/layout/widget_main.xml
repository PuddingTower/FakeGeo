<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_title"
            android:textColor="#E6EEEA"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ 已停止"
            android:textColor="#90A39C"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="尚未选择位置"
        android:textColor="#E6EEEA"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_environment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="手工配置 · 点击打开拟境"
        android:textColor="#90A39C"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_master"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pill_off"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="开启虚拟定位"
        android:textColor="#5FE0C8"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_toggle_location"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_off"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="定位"
            android:textColor="#90A39C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_toggle_wifi"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_off"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Wi-Fi"
            android:textColor="#90A39C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_toggle_bluetooth"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_off"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="蓝牙"
            android:textColor="#90A39C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_toggle_cell"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_off"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="基站"
            android:textColor="#90A39C"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
